# Maintainer: Galaxy1108
pkgname=smartclassroom
pkgver=0.11.0
pkgrel=1
pkgdesc="智慧课堂——跨平台教室增强应用（课表联动/QQ 消息/AI 整理/课件推送）"
arch=('x86_64')
url="https://example.com"
license=('MIT')
# self-contained 发布：不依赖系统 dotnet。nodejs 供 pi-ai 边车使用（要求 ≥ 22.19）。
depends=('gcc-libs' 'glibc' 'icu' 'openssl' 'zlib' 'nodejs')
options=('!strip')
# 构建产物由 pkg/build-linux.sh 预生成到 pkg/stage（含 ai-sidecar/node_modules）。
source=('smartclassroom.sh'
        'smartclassroom.desktop')
sha256sums=('SKIP'
            'SKIP')

package() {
    local stagedir="$startdir/stage"
    if [[ ! -x "$stagedir/SmartClassroom.App" ]]; then
        echo "缺构建产物：请先运行 pkg/build-linux.sh" >&2
        return 1
    fi
    if [[ ! -d "$stagedir/ai-sidecar/node_modules" ]]; then
        echo "缺 AI 边车依赖：请先运行 pkg/build-linux.sh" >&2
        return 1
    fi
    install -dm755 "$pkgdir/opt/smartclassroom"
    cp -a "$stagedir/." "$pkgdir/opt/smartclassroom/"

    # 工作区/CI 的文件可能是 0600（cp -a 会原样带进来），安装后普通用户读不了 → 边车 EACCES。
    # a+rX 的语义正好：给所有人加读；只给「目录」和「原本就有执行位的文件」加执行位，
    # 所以既能修 0600，又不会破坏 SmartClassroom.App / createdump 的可执行位。
    chmod -R a+rX "$pkgdir/opt/smartclassroom"

    install -Dm755 "$srcdir/smartclassroom.sh" "$pkgdir/usr/bin/smartclassroom"
    install -Dm644 "$srcdir/smartclassroom.desktop" "$pkgdir/usr/share/applications/smartclassroom.desktop"
}

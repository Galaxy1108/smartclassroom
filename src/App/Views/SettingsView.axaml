<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             x:Class="SmartClassroom.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12" Margin="4">
            <TextBlock Text="AI" FontWeight="Bold" FontSize="15" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="BaseUrl" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AiBaseUrl}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AiModel}" />
            </Grid>

            <TextBlock Text="QQ 连接（OneBot）" FontWeight="Bold" FontSize="15" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="HTTP" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OneBotHttp}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="WebSocket" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OneBotWs}" />
            </Grid>

            <TextBlock Text="SnowLuma 下载器（不随应用附带）" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="{Binding InstallDir}" Opacity="0.6" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="刷新版本" Click="Refresh_Click" />
                <ComboBox MinWidth="160" ItemsSource="{Binding Releases}"
                          SelectedItem="{Binding SelectedRelease}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsViewModel">
                            <TextBlock Text="{Binding Tag}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="下载并安装" Click="Download_Click" />
            </StackPanel>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"
                         IsVisible="{Binding Busy}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="启动" Click="Start_Click" />
                <Button Content="停止" Click="Stop_Click" />
                <Button Content="探测状态" Click="Probe_Click" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <TextBlock Text="日志" FontWeight="Bold" FontSize="15" />
            <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                     Height="160" FontFamily="Monospace" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

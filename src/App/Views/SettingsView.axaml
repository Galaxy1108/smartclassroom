<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:qq="using:SmartClassroom.Core.QQ"
             xmlns:ai="using:SmartClassroom.Core.AI"
             xmlns:local="using:SmartClassroom.App.Views"
             x:Class="SmartClassroom.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- 用 Stretch + MaxWidth（而不是 Left）：保证子元素测量时拿到有限宽度，
             否则换行文本会按无限宽度测量、按有限宽度排布，导致高度算错（底边被切）。 -->
        <StackPanel Spacing="8" Margin="4,4,16,24" MaxWidth="900" HorizontalAlignment="Stretch">

            <local:NoticeBar Severity="Warning" IsVisible="{Binding IsLocked}"
                             Title="设置已锁定"
                             Message="已启用管理员密码。解锁后才能修改设置、切换功能开关。">
                <local:NoticeBar.ActionContent>
                    <Button Content="解锁设置" Classes="accent" Click="Unlock_Click" />
                </local:NoticeBar.ActionContent>
            </local:NoticeBar>

            <StackPanel Spacing="4" IsEnabled="{Binding !IsLocked}">

            <!-- ================= 功能开关（默认全关） ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconSettings}" VerticalAlignment="Center" />
                <TextBlock Text="功能开关" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>


            <fa:SettingsExpander Header="召唤通知"
                                 Description="老师在群里叫「xxx 来一下」时发 ClassIsland 通知；上课中排队、下课再发，带「现在/立刻」则立刻发。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FeatureSummon}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="作业自动录入"
                                 Description="AI 把老师宣布的当日作业整理成条目上墙到「作业」页。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FeatureHomework}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="换课自动处理"
                                 Description="AI 解析换课（调换/替换/跨天）后交插件校验，合法才落课（临时层），非法转人工。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FeatureExchange}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="群文件自动归档"
                                 Description="老师发的群文件自动下载，按发送者分类存到归档目录。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FeatureFileArchive}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="上课课件弹窗"
                                 Description="上课时若当天该科老师发过文件，弹出「您可能需要的课件」窗口。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding FeatureCoursewarePopup}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <TextBlock Text="{Binding FeatureSummary}" FontSize="12" Opacity="0.75"
                       TextWrapping="Wrap" Margin="2,4,0,0" />

            <!-- ================= AI ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconCloud}" VerticalAlignment="Center" />
                <TextBlock Text="AI" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <fa:SettingsExpander Header="接入引擎"
                                 Description="内置直连零依赖；pi-ai 经 Node 边车，自带多厂商模型目录。">
                <fa:SettingsExpander.IconSource>
                    <fa:PathIconSource Data="{StaticResource IconSettings}" />
                </fa:SettingsExpander.IconSource>
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="250" ItemsSource="{Binding Engines}"
                              SelectedItem="{Binding EngineOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EngineOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="vm:EngineOption">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- Node 缺失提示 + 下载器（仅 pi-ai 且 Node 不可用时） -->
            <local:NoticeBar Severity="Warning"
                             IsVisible="{Binding ShowNodeInstaller}"
                             Title="使用 pi-ai 需要 Node 运行时"
                             Message="未检测到可用的 Node（要求 ≥ 22.19）。可以在下面下载一份到用户目录，或自行安装；也可以先把引擎切回「内置直连」。">
                <local:NoticeBar.ActionContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="140" ItemsSource="{Binding NodeReleases}"
                                  SelectedItem="{Binding SelectedNode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ai:NodeRelease">
                                    <TextBlock Text="{Binding Version}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="ai:NodeRelease">
                                    <TextBlock Text="{Binding Version}" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <Button Content="查询版本" Click="LoadNodeVersions_Click" />
                        <Button Content="下载并安装 Node" Classes="accent" Click="DownloadNode_Click" />
                    </StackPanel>
                </local:NoticeBar.ActionContent>
            </local:NoticeBar>
            <ProgressBar Value="{Binding NodeProgress}" Minimum="0" Maximum="100" Height="6"
                         IsVisible="{Binding ShowNodeInstaller}" Margin="0,4" />

            <fa:SettingsExpander Header="服务商" IsVisible="{Binding IsHttpGateway}"
                                 Description="选预设自动填地址，选自定义后手动填。">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="220" ItemsSource="{Binding AiProviders}"
                              SelectedItem="{Binding AiProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiProviderPreset">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="vm:AiProviderPreset">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="pi-ai 运行时" IsVisible="{Binding IsPiAi}"
                                 Description="需要 Node ≥ 22.19；边车依赖已随包安装。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SidecarInfo}" VerticalAlignment="Center" FontSize="12" />
                        <Button Content="重新检测" Click="RefreshSidecar_Click" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="provider / 模型" IsVisible="{Binding IsPiAi}"
                                 Description="从 pi-ai 目录拉取；模型列表含上下文长度与能力标记。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="170" ItemsSource="{Binding PiProviders}"
                                  SelectedItem="{Binding SelectedProvider}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ai:SidecarProvider">
                                    <TextBlock Text="{Binding Id}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="ai:SidecarProvider">
                                    <TextBlock Text="{Binding Id}" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <ComboBox MinWidth="200" ItemsSource="{Binding PiModels}"
                                  SelectedItem="{Binding SelectedModel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ai:SidecarModel">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="ai:SidecarModel">
                                    <TextBlock Text="{Binding Id}" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <Button Content="载入目录" Click="LoadCatalog_Click" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="服务地址"
                                 Description="pi-ai 引擎留空则用所选 provider 官方端点；填了则按自定义 OpenAI 兼容端点处理。">
                <fa:SettingsExpander.Footer>
                    <TextBox Text="{Binding AiBaseUrl}" MinWidth="300" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="API Key"
                                 Description="只写入本机 settings.json，不上传任何地方。">
                <fa:SettingsExpander.Footer>
                    <TextBox Text="{Binding AiApiKey}" MinWidth="300" PasswordChar="•" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="模型" IsVisible="{Binding IsHttpGateway}"
                                 Description="可从预设选，也可直接输入。">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="220" ItemsSource="{Binding ModelPresets}"
                              SelectedItem="{Binding AiModel, Mode=TwoWay}" IsEditable="True" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="连通性测试"
                                 Description="用当前配置发一条最小请求，验证地址/Key/模型是否可用。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="测试" Classes="accent" Click="TestAi_Click" />
                        <TextBlock Text="{Binding AiTestResult}" VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- ================= 教师映射 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconPerson}" VerticalAlignment="Center" />
                <TextBlock Text="教师映射" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <fa:SettingsExpander Header="任课老师"
                                 Description="QQ 号（可空）/ 姓名或群名片 / 科目。匹配顺序：QQ 号 → 群名片 → 昵称。">
                <fa:SettingsExpander.IconSource>
                    <fa:PathIconSource Data="{StaticResource IconPerson}" />
                </fa:SettingsExpander.IconSource>
                <fa:SettingsExpander.Footer>
                    <Button Content="保存设置" Click="Save_Click" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <ItemsControl ItemsSource="{Binding Teachers}" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TeacherRow">
                        <Border Margin="0,2" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Qq}" Width="110" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Width="120" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Subject}" Width="120" VerticalAlignment="Center" />
                                <Button Content="删除" Click="RemoveTeacher_Click" Tag="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                <TextBox Watermark="QQ 号" Text="{Binding NewTeacherQq}" Width="120" />
                <TextBox Watermark="姓名/名片" Text="{Binding NewTeacherName}" Width="130" />
                <TextBox Watermark="科目" Text="{Binding NewTeacherSubject}" Width="120" />
                <Button Content="添加" Classes="accent" Click="AddTeacher_Click" />
            </StackPanel>

            <!-- ================= ClassIsland 集成 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconAlert}" VerticalAlignment="Center" />
                <TextBlock Text="ClassIsland 集成" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <fa:SettingsExpander Header="桥接端口"
                                 Description="本应用经 127.0.0.1 调用插件接口（默认 5199），需与插件一致。">
                <fa:SettingsExpander.IconSource>
                    <fa:PathIconSource Data="{StaticResource IconSettings}" />
                </fa:SettingsExpander.IconSource>
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding PluginPort}" Minimum="1024" Maximum="65535" MinWidth="140" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="桥接 Token"
                                 Description="插件首次启动自动生成；点右侧按钮可自动查找并填入。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding PluginToken}" MinWidth="240" PasswordChar="•" />
                        <Button Content="自动查找" Click="LocateToken_Click" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="连接状态" Description="探测插件是否已加载并在线。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="探测" Click="ProbePlugin_Click" />
                        <TextBlock Text="{Binding PluginStatus}" VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="340" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- ================= QQ 连接 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconCloud}" VerticalAlignment="Center" />
                <TextBlock Text="QQ 连接" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <local:NoticeBar Severity="Informational" IsVisible="{Binding !IsInstalled}"
                             Title="您还没有下载 SnowLuma 注入层"
                             Message="下载后即可注入已登录的班级 QQ，无需单独 QQ 实例；也可以跳过下载，直接在下方填写已有的 OneBot v11 地址。" />

            <fa:SettingsExpander Header="SnowLuma 下载器" IsVisible="{Binding !IsInstalled}"
                                 Description="不随应用附带。完整版内置 Node，精简版需自装 Node ≥ 22。">
                <fa:SettingsExpander.IconSource>
                    <fa:PathIconSource Data="{StaticResource IconFolder}" />
                </fa:SettingsExpander.IconSource>
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="150" ItemsSource="{Binding Releases}"
                                  SelectedItem="{Binding SelectedRelease}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="qq:SnowlumaRelease">
                                    <TextBlock Text="{Binding Tag}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="qq:SnowlumaRelease">
                                    <TextBlock Text="{Binding Tag}" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <Button Content="刷新" Click="Refresh_Click" />
                        <Button Content="下载并安装" Classes="accent" Click="Download_Click" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"
                         IsVisible="{Binding Busy}" Margin="0,4" />

            <local:NoticeBar Severity="Error" IsVisible="{Binding IsInstalled}"
                             Title="风险警告"
                             Message="QQ 官方可能检测到第三方登录方式并封禁账号。强烈建议不要使用全新注册的 QQ 号操作；班级号请确认可以接受该风险后再启动注入。" />
            <fa:SettingsExpander Header="我已知晓风险" IsVisible="{Binding IsInstalled}"
                                 Description="勾选后才允许启动注入。">
                <fa:SettingsExpander.Footer>
                    <CheckBox IsChecked="{Binding RiskAccepted}" Content="已知晓" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="运行状态" IsVisible="{Binding IsInstalled}"
                                 Description="注入三态：QQ 未运行 / 已注入未登录 / 在线。">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="启动" Click="Start_Click" IsEnabled="{Binding RiskAccepted}" />
                        <Button Content="停止" Click="Stop_Click" />
                        <Button Content="探测" Click="Probe_Click" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <local:NoticeBar Severity="Success" IsVisible="{Binding QqDetected}"
                             Title="检测到 QQ，是否自动连接？"
                             Message="将填入默认 OneBot 地址并保存，重启应用后消息管线会自动连接。">
                <local:NoticeBar.ActionContent>
                    <Button Content="自动连接" Classes="accent" Click="AutoConnect_Click" />
                </local:NoticeBar.ActionContent>
            </local:NoticeBar>

            <fa:SettingsExpander Header="OneBot HTTP" Description="SnowLuma 默认 http://127.0.0.1:3000">
                <fa:SettingsExpander.Footer>
                    <TextBox Text="{Binding OneBotHttp}" MinWidth="280" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="OneBot WebSocket" Description="SnowLuma 默认 ws://127.0.0.1:3001">
                <fa:SettingsExpander.Footer>
                    <TextBox Text="{Binding OneBotWs}" MinWidth="280" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="监听群号" Description="英文逗号分隔，只处理这些群的消息。">
                <fa:SettingsExpander.Footer>
                    <TextBox Text="{Binding GroupIdsText}" MinWidth="280" Watermark="如 123456,789012" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander Header="开机自启 SnowLuma"
                                 Description="Windows 写 Startup 文件夹，Linux 写 autostart。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AutostartEnabled}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- ================= 安全与关闭行为 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconPerson}" VerticalAlignment="Center" />
                <TextBlock Text="安全与关闭行为" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <fa:SettingsExpander Header="管理员密码"
                                 Description="设置后，改设置、切换功能开关、增删作业、处理待确认、以及彻底退出都需要输入密码。留空表示不启用。">
                <fa:SettingsExpander.IconSource>
                    <fa:PathIconSource Data="{StaticResource IconWarning}" />
                </fa:SettingsExpander.IconSource>
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding NewPassword}" PasswordChar="•" Width="130"
                                 Watermark="{Binding PasswordWatermark}" />
                        <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" Width="130"
                                 Watermark="再次输入" />
                        <Button Content="应用" Classes="accent" Click="ApplyPassword_Click" />
                    </StackPanel>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <TextBlock Text="{Binding PasswordResult}" FontSize="12" Opacity="0.8"
                       TextWrapping="Wrap" Margin="2,0,0,0" />

            <fa:SettingsExpander Header="退出应用"
                                 Description="彻底关闭智慧课堂。已设置管理员密码时需要验证身份。">
                <fa:SettingsExpander.Footer>
                    <Button Content="退出应用" Click="QuitApp_Click" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="关闭主窗口时收回到托盘"
                                 Description="{Binding TrayHint}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <!-- ================= 日志 ================= -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,4">
                <PathIcon Width="16" Height="16" Data="{StaticResource IconInfo}" VerticalAlignment="Center" />
                <TextBlock Text="日志" Theme="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
            <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                     Height="170" FontFamily="Monospace" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

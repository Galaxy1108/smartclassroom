<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:SmartClassroom.Core"
             xmlns:local="using:SmartClassroom.App.Views"
             x:Class="SmartClassroom.App.Views.EventsView"
             x:DataType="vm:EventsViewModel">
    <UserControl.Styles>
        <!-- 时间线卡片按严重级别着色（信息=蓝 / 成功=绿 / 警告=橙 / 错误=红）。
             配色与 NoticeBar 一致，颜色定义在 App.axaml 的主题字典里，随浅色/深色切换。 -->
        <Style Selector="Border.tlrow">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SeverityInfoFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeverityInfoStrokeBrush}" />
        </Style>
        <Style Selector="Border.tlrow Border.tlstrip">
            <Setter Property="Background" Value="{DynamicResource SeverityInfoAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SeverityInfoAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow TextBlock.tlseverity">
            <Setter Property="Foreground" Value="{DynamicResource SeverityInfoAccentBrush}" />
        </Style>

        <Style Selector="Border.tlrow.success">
            <Setter Property="Background" Value="{DynamicResource SeveritySuccessFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeveritySuccessStrokeBrush}" />
        </Style>
        <Style Selector="Border.tlrow.success Border.tlstrip">
            <Setter Property="Background" Value="{DynamicResource SeveritySuccessAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.success PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SeveritySuccessAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.success TextBlock.tlseverity">
            <Setter Property="Foreground" Value="{DynamicResource SeveritySuccessAccentBrush}" />
        </Style>

        <Style Selector="Border.tlrow.warning">
            <Setter Property="Background" Value="{DynamicResource SeverityWarningFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeverityWarningStrokeBrush}" />
        </Style>
        <Style Selector="Border.tlrow.warning Border.tlstrip">
            <Setter Property="Background" Value="{DynamicResource SeverityWarningAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.warning PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SeverityWarningAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.warning TextBlock.tlseverity">
            <Setter Property="Foreground" Value="{DynamicResource SeverityWarningAccentBrush}" />
        </Style>

        <Style Selector="Border.tlrow.error">
            <Setter Property="Background" Value="{DynamicResource SeverityErrorFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SeverityErrorStrokeBrush}" />
        </Style>
        <Style Selector="Border.tlrow.error Border.tlstrip">
            <Setter Property="Background" Value="{DynamicResource SeverityErrorAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.error PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SeverityErrorAccentBrush}" />
        </Style>
        <Style Selector="Border.tlrow.error TextBlock.tlseverity">
            <Setter Property="Foreground" Value="{DynamicResource SeverityErrorAccentBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- ============ 待处理：AI 没处理掉的群消息，这里给出口 ============ -->
            <local:NoticeBar Severity="Informational" IsVisible="{Binding RequiresPassword}"
                             Title="需要管理员密码"
                             Message="已启用管理员密码。重新解析、人工录入、忽略前会要求验证身份。" />

            <local:NoticeBar Severity="Warning" IsVisible="{Binding HasPending}"
                             Title="{Binding PendingHeader}" Message="{Binding PendingHint}" />

            <ItemsControl ItemsSource="{Binding Pending}" IsVisible="{Binding HasPending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingRow">
                        <Border Margin="0,2" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Padding="6,1" CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RetryLabel}" FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" Opacity="0.9" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Sender}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding Reason}" FontSize="11" Opacity="0.7"
                                               TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button Content="重新解析" Classes="accent" Click="Retry_Click" Tag="{Binding}" />
                                    <Button Content="手动录入" Click="Edit_Click" Tag="{Binding}" />
                                    <Button Content="忽略" Click="Ignore_Click" Tag="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 人工录入表单（按 kind 显示不同字段） -->
            <Border IsVisible="{Binding IsEditing}" Padding="12,10" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="人工录入" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Editing.RawText}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                    <!-- 作业 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsEditingHomework}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="科目" VerticalAlignment="Center" Width="60" />
                            <TextBox Text="{Binding FormSubject}" Width="150" Watermark="数学" />
                            <TextBlock Text="日期" VerticalAlignment="Center" Width="44" />
                            <TextBox Text="{Binding FormDate}" Width="130" Watermark="yyyy-MM-dd" />
                        </StackPanel>
                        <TextBlock Text="作业条目（一行一条）" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding FormItems}" AcceptsReturn="True" Height="90"
                                 TextWrapping="Wrap" Watermark="练习册P10&#x0a;试卷一张" />
                    </StackPanel>

                    <!-- 召唤 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsEditingSummon}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="被叫的人" VerticalAlignment="Center" Width="60" />
                            <TextBox Text="{Binding FormTarget}" Width="180" Watermark="小明" />
                            <CheckBox IsChecked="{Binding FormUrgent}" Content="要求现在就去" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 换课 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsEditingExchange}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="类型" VerticalAlignment="Center" Width="60" />
                            <ComboBox ItemsSource="{Binding ExchangeKinds}" SelectedItem="{Binding FormKind}" Width="130" />
                            <TextBlock Text="日期" VerticalAlignment="Center" Width="44" />
                            <TextBox Text="{Binding FormDate}" Width="130" Watermark="yyyy-MM-dd" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="原节次" VerticalAlignment="Center" Width="60" />
                            <TextBox Text="{Binding FormFromPeriod}" Width="70" />
                            <TextBlock Text="目标节次" VerticalAlignment="Center" Width="70" />
                            <TextBox Text="{Binding FormToPeriod}" Width="70" />
                            <TextBlock Text="替换为" VerticalAlignment="Center" Width="56" />
                            <TextBox Text="{Binding FormNewSubject}" Width="110" Watermark="仅替换时填" />
                        </StackPanel>
                        <TextBlock Text="跨天换课时目标节次按同一日期填写需自行确认；提交仍会经插件合法性校验。"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="提交" Classes="accent" Click="Submit_Click" />
                        <Button Content="取消" Click="Cancel_Click" />
                        <TextBlock Text="{Binding ActionResult}" VerticalAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ActionResult}" IsVisible="{Binding !IsEditing}"
                       FontSize="12" Opacity="0.85" TextWrapping="Wrap" />

            <!-- ============ 决策时间线 ============ -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="16" Height="16" Data="{StaticResource IconInfo}" VerticalAlignment="Center" />
                    <TextBlock Text="决策时间线" Theme="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="复制全部" Click="CopyAll_Click" IsEnabled="{Binding HasEntries}"
                            ToolTip.Tip="把整条时间线复制到剪贴板" />
                    <Button Content="清空" Click="ClearTimeline_Click" IsEnabled="{Binding HasEntries}"
                            ToolTip.Tip="清空时间线（它不会随重启自动清空，所以给了这个入口）" />
                </StackPanel>
            </Grid>
            <TextBlock Text="应用对群里消息做了什么、为什么没做，都记在这里。保留最近 200 条，且跨重启保留（存在 state.json）；可逐条复制或手动清空。"
                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

            <TextBlock Text="{Binding TimelineResult}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRow">
                        <Border Classes="tlrow"
                                Classes.success="{Binding IsSuccess}"
                                Classes.warning="{Binding IsWarning}"
                                Classes.error="{Binding IsError}">
                            <Grid ColumnDefinitions="4,*,Auto">
                                <!-- 左侧严重级别色条 -->
                                <Border Grid.Column="0" Classes="tlstrip" Width="4" CornerRadius="6,0,0,6" />
                                <StackPanel Grid.Column="1" Margin="10,7" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                                  Data="{StaticResource IconInfo}" IsVisible="{Binding IsInfo}" />
                                        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                                  Data="{StaticResource IconAlert}" IsVisible="{Binding IsSuccess}" />
                                        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                                  Data="{StaticResource IconWarning}" IsVisible="{Binding IsWarning}" />
                                        <PathIcon Width="13" Height="13" VerticalAlignment="Center"
                                                  Data="{StaticResource IconAlert}" IsVisible="{Binding IsError}" />
                                        <TextBlock Classes="tlseverity" Text="{Binding SeverityLabel}"
                                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Time}" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fa:ProgressRing Width="14" Height="14" IsIndeterminate="True"
                                                         IsVisible="{Binding InProgress}" VerticalAlignment="Center" />
                                        <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                             TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ElapsedText}" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"
                                                   IsVisible="{Binding InProgress}" />
                                    </StackPanel>
                                    <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                         FontSize="12" Opacity="0.85" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="复制" FontSize="11" Margin="6,6,6,0"
                                        VerticalAlignment="Top" Padding="8,3"
                                        Click="CopyEntry_Click" Tag="{Binding}"
                                        ToolTip.Tip="复制这条记录" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="暂无记录。应用处理群消息后，这里会出现对应的行。"
                       IsVisible="{Binding IsEmptyTimeline}" FontSize="12" Opacity="0.55" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

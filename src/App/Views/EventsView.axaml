<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             xmlns:c="using:SmartClassroom.Core"
             x:Class="SmartClassroom.App.Views.EventsView"
             x:DataType="vm:EventsViewModel">
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:ActivityEntry">
                    <Border Margin="4" Padding="8" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding At, StringFormat='{}{0:MM-dd HH:mm}'}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>

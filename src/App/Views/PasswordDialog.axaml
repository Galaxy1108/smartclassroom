<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartClassroom.App.Views.PasswordDialog"
        Title="需要管理员密码"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Text="已启用管理员密码，此操作需要验证身份。" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="管理员密码" />
        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" FontSize="12" IsVisible="False" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="取消" Click="Cancel_Click" />
            <Button Content="确认" Classes="accent" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

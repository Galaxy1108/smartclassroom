<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             xmlns:local="using:SmartClassroom.App"
             x:Class="SmartClassroom.App.Views.HomeworkView"
             x:DataType="vm:HomeworkViewModel">

    <UserControl.Resources>
        <!-- 卡片右键菜单：编辑 / 删除（DataContext 会继承卡片，处理里直接取） -->
        <ContextMenu x:Key="HomeworkCardMenu">
            <MenuItem Header="编辑" Click="EditCard_Click" />
            <MenuItem Header="删除" Click="DeleteCard_Click" />
        </ContextMenu>

        <!-- 卡片外观抽成资源：列表和拖拽时的"虚"卡片共用同一模板，保证长得一样 -->
        <DataTemplate x:Key="HomeworkCardTemplate" x:DataType="vm:HomeworkCard">
            <Border Classes="hwcard" MinHeight="120"
                    CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            ContextMenu="{StaticResource HomeworkCardMenu}">
                <Grid ColumnDefinitions="6,*">
                    <Border Grid.Column="0" Background="{Binding AccentColor}" />
                    <StackPanel Grid.Column="1" Margin="12,10,12,10" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="16"
                                       Foreground="{Binding AccentColor}" VerticalAlignment="Center" />
                            <Border CornerRadius="4" Padding="6,1"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding RelativeDay}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding DateLabel}" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeworkLine">
                                    <Grid ColumnDefinitions="22,*" Margin="0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='{}{0}.'}"
                                                   Opacity="0.55" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- 不用 IsEnabled 绑定：这个 XAML 里解析不了 vm: 类型（实测会让启动崩溃），
                                 锁定状态交给点击处理里的管理员密码闸门 -->
                            <TextBlock Text="{Binding Sender}" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding ItemCountLabel}" FontSize="11" Opacity="0.5" />
                            <!-- 截止时间：AI 把"后天交"换算成具体日期；**没写截止就不显示这一行** -->
                            <TextBlock Text="{Binding DueLabel, StringFormat='截止：{0}'}" FontSize="11"
                                       IsVisible="{Binding HasDue}"
                                       Foreground="{DynamicResource SeverityWarningAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" HorizontalAlignment="Stretch">
        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="手动添加作业" Classes="accent" Click="BeginAdd_Click"
                    IsEnabled="{Binding !IsLocked}" />
            <Button Content="解锁" Click="Unlock_Click" IsVisible="{Binding IsLocked}" />
            <TextBlock Text="长按卡片 0.3 秒可拖动排序 · 右键卡片可编辑/删除 · Ctrl+滚轮缩放本区域" FontSize="12" Opacity="0.55"
                       VerticalAlignment="Center" IsVisible="{Binding !IsEmpty}" />
            <TextBlock Text="{Binding AddResult}" VerticalAlignment="Center" FontSize="12"
                       Opacity="0.85" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>

        <!-- 手动添加表单 -->
        <Border Grid.Row="1" IsVisible="{Binding IsAdding}" Margin="0,0,0,10"
                Padding="14,12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="手动添加作业" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="科目" VerticalAlignment="Center" Width="60" />
                    <TextBox Text="{Binding FormSubject}" Width="150" Watermark="数学" />
                    <TextBlock Text="日期" VerticalAlignment="Center" Width="44" />
                    <TextBox Text="{Binding FormDate}" Width="130" Watermark="yyyy-MM-dd" />
                    <TextBlock Text="截止" VerticalAlignment="Center" Width="44" />
                    <TextBox Text="{Binding FormDue}" Width="170"
                             Watermark="可空；不用交就写「无需提交」" />
                </StackPanel>
                <TextBlock Text="作业条目（一行一条，同科目同日会自动合并去重）" FontSize="12" Opacity="0.7" />
                <TextBox Text="{Binding FormItems}" AcceptsReturn="True" Height="90"
                         TextWrapping="Wrap" Watermark="练习册P10&#x0a;试卷一张" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="提交" Classes="accent" Click="SubmitAdd_Click" />
                    <Button Content="取消" Click="CancelAdd_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 卡片区（缩放只作用于这里） -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <LayoutTransformControl x:Name="CardScaler">
                <!-- CardLayer 是拖拽覆盖层的坐标基准；overlay 不参与命中测试 -->
                <Panel x:Name="CardLayer">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding EmptyHint}"
                                   IsVisible="{Binding IsEmpty}" Opacity="0.6" TextWrapping="Wrap" />
                        <ItemsControl x:Name="HomeworkList" ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource HomeworkCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 瀑布流：列数随宽度自适应，卡片拉伸填满，每列独立堆叠 -->
                                    <local:MasonryPanel MinItemWidth="300" Gap="10" MaxColumns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
                        <!-- 目标位置指示：虚线边框，框住将要落位的格子 -->
                        <Rectangle x:Name="SlotIndicator" IsVisible="False"
                                   StrokeThickness="2" StrokeDashArray="5,4"
                                   RadiusX="8" RadiusY="8"
                                   Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                   Fill="#1A0F6CBD" />
                        <!-- 跟随指针的"虚"卡片 -->
                        <ContentControl x:Name="DragGhost" IsVisible="False"
                                        ContentTemplate="{StaticResource HomeworkCardTemplate}"
                                        Opacity="0.92" />
                    </Canvas>
                </Panel>
            </LayoutTransformControl>
        </ScrollViewer>
    </Grid>
</UserControl>

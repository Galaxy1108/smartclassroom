<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartClassroom.App.ViewModels"
        xmlns:views="using:SmartClassroom.App.Views"
        xmlns:app="using:SmartClassroom.App"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="SmartClassroom.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="智慧课堂" Width="1000" Height="640" MinWidth="720" MinHeight="480">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <fa:NavigationView Grid.Row="0" x:Name="NavView"
                           PaneDisplayMode="Auto"
                           IsSettingsVisible="False"
                           OpenPaneLength="200"
                           SelectionChanged="NavView_SelectionChanged">
            <fa:NavigationView.MenuItems>
                <fa:NavigationViewItem Content="作业" Tag="home">
                    <fa:NavigationViewItem.IconSource>
                        <fa:PathIconSource Data="{StaticResource IconHome}" />
                    </fa:NavigationViewItem.IconSource>
                </fa:NavigationViewItem>
                <fa:NavigationViewItem Content="事件" Tag="events">
                    <fa:NavigationViewItem.IconSource>
                        <fa:PathIconSource Data="{StaticResource IconAlert}" />
                    </fa:NavigationViewItem.IconSource>
                </fa:NavigationViewItem>
                <fa:NavigationViewItem Content="课件" Tag="courseware">
                    <fa:NavigationViewItem.IconSource>
                        <fa:PathIconSource Data="{StaticResource IconFolder}" />
                    </fa:NavigationViewItem.IconSource>
                </fa:NavigationViewItem>
                <fa:NavigationViewItem Content="设置" Tag="settings">
                    <fa:NavigationViewItem.IconSource>
                        <fa:PathIconSource Data="{StaticResource IconSettings}" />
                    </fa:NavigationViewItem.IconSource>
                </fa:NavigationViewItem>
            </fa:NavigationView.MenuItems>
            <ScrollViewer Padding="20,12,20,20">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PageTitle" Theme="{StaticResource TitleTextBlockStyle}" Text="作业" />
                    <ContentControl x:Name="PageHost" />
                </StackPanel>
            </ScrollViewer>
        </fa:NavigationView>

        <Border Grid.Row="1" Padding="12,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8" />
        </Border>

        <!-- 应用内通知：右下角浮出，几秒后自动消失。
             启动/停止 SnowLuma、下载、AI 测试这类耗时操作完成后必须给反馈，
             否则用户只会看到"点了没反应"，以为失败了。 -->
        <ItemsControl Grid.Row="0" x:Name="ToastList"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,16,16" MaxWidth="420"
                      IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:ToastItem">
                    <Border Margin="0,6,0,0" CornerRadius="6" BoxShadow="0 4 16 0 #33000000">
                        <views:NoticeBar Severity="{Binding Severity}"
                                         Title="{Binding Title}"
                                         Message="{Binding Message}">
                            <views:NoticeBar.ActionContent>
                                <Button Content="关闭" FontSize="11" Padding="8,3"
                                        Click="ToastClose_Click" Tag="{Binding}" />
                            </views:NoticeBar.ActionContent>
                        </views:NoticeBar>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</Window>

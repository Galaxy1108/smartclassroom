<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartClassroom.App.ViewModels"
        xmlns:views="using:SmartClassroom.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="SmartClassroom.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="智慧课堂">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8" />
        </Border>

        <TabControl Margin="8">
            <TabItem Header="作业">
                <views:HomeworkView />
            </TabItem>
            <TabItem Header="事件">
                <views:EventsView />
            </TabItem>
            <TabItem Header="课件">
                <TextBlock Text="当天课件（v0.4 文件归档后展示）"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
            </TabItem>
            <TabItem Header="设置">
                <views:SettingsView />
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             x:Class="SmartClassroom.App.Views.CoursewareListView"
             x:DataType="vm:CoursewareViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="当天归档的课件都在这里，双击打开。"
                   Opacity="0.6" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CoursewareItem">
                    <Border Width="150" Margin="4" Padding="8" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            DoubleTapped="Card_DoubleTapped" Cursor="Hand">
                        <StackPanel Spacing="4">
                            <Image Source="{Binding Thumbnail}" Width="120" Height="80"
                                   Stretch="Uniform" IsVisible="{Binding IsImage}" />
                            <Border Height="80" CornerRadius="4" IsVisible="{Binding !IsImage}"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="22" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" MaxLines="2"
                                       FontSize="12" />
                            <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartClassroom.App.ViewModels"
             x:Class="SmartClassroom.App.Views.CoursewareListView"
             x:DataType="vm:CoursewareViewModel">
    <UserControl.Styles>
        <!-- 时间轴：左侧一条竖线 + 每行的圆点 -->
        <Style Selector="Border.tlrail">
            <Setter Property="Width" Value="2" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Ellipse.tldot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.tlcard">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tlcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.subjectcard">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.subjectcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">
        <!-- ============ 第一层：科目 ============ -->
        <StackPanel Spacing="8" IsVisible="{Binding IsSubjectList}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="按科目查看已归档的课件。" Opacity="0.6" VerticalAlignment="Center" />
                <Button Content="预览上课弹窗" Click="Preview_Click" />
            </StackPanel>
            <TextBlock Text="{Binding EmptyHint}" IsVisible="{Binding IsEmpty}"
                       Opacity="0.6" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Subjects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoursewareSubject">
                        <Border Classes="subjectcard" Width="200" Margin="0,0,8,8"
                                DoubleTapped="Subject_DoubleTapped" Tapped="Subject_Tapped">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding LatestText}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ============ 第二层：时间轴 ============ -->
        <StackPanel Spacing="8" IsVisible="{Binding IsTimeline}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="← 返回科目" Click="Back_Click" />
                <TextBlock Text="{Binding SubjectTitle}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="双击打开文件" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Timeline}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoursewareDayGroup">
                        <StackPanel Spacing="4" Margin="0,4,0,10">
                            <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" Opacity="0.8" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CoursewareTimelineRow">
                                        <Grid ColumnDefinitions="52,20,*,Auto" Margin="0,2">
                                            <!-- 时间 -->
                                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                                       FontSize="12" Opacity="0.65" Margin="0,6,0,0" />
                                            <!-- 竖线 + 圆点 -->
                                            <Panel Grid.Column="1">
                                                <Border Classes="tlrail" HorizontalAlignment="Center"
                                                        Margin="0,0,0,-6" />
                                                <Ellipse Classes="tldot" HorizontalAlignment="Center"
                                                         VerticalAlignment="Top" Margin="0,8,0,0" />
                                            </Panel>
                                            <!-- 文件卡片 -->
                                            <Border Grid.Column="2" Classes="tlcard" Margin="0,2,8,2"
                                                    DoubleTapped="Card_DoubleTapped">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Image Source="{Binding Thumbnail}" Width="64" Height="44"
                                                           Stretch="Uniform" IsVisible="{Binding IsImage}" />
                                                    <Border Width="52" Height="44" CornerRadius="4"
                                                            IsVisible="{Binding !IsImage}"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="13"
                                                                   FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap"
                                                                   MaxWidth="420" />
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.6" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>

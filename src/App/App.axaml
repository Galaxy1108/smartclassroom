<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartClassroom.App.App"
             xmlns:local="using:SmartClassroom.App"
             xmlns:styling="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             RequestedThemeVariant="Default">
             <!-- WinUI3 外观：FluentAvalonia 主题（与 ClassIsland 同款），跟随系统浅色/深色 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />

        <!-- 作业卡片：悬停提亮；长按拖拽时"抬起"（缩放 + 阴影 + 强调边），都带过渡 -->
        <Style Selector="Border.hwcard">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.hwcard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
        <!-- 被拖动的那张原位卡片压暗（不做缩放，避免超出格子边界） -->
        <Style Selector="Border.hwcard.dragging">
            <Setter Property="Opacity" Value="0.3" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WinUI 3 的标准强调色 #0078D4 及其明暗梯度。
                 FAUI 的按钮/开关/选中态都读这些键，不设的话会落到它自带的紫色。 -->
            <Color x:Key="SystemAccentColor">#0078D4</Color>
            <Color x:Key="SystemAccentColorLight1">#1A86D9</Color>
            <Color x:Key="SystemAccentColorLight2">#3FA0E1</Color>
            <Color x:Key="SystemAccentColorLight3">#66B5E8</Color>
            <Color x:Key="SystemAccentColorDark1">#0069BC</Color>
            <Color x:Key="SystemAccentColorDark2">#005CA5</Color>
            <Color x:Key="SystemAccentColorDark3">#004F8D</Color>
            <!-- 严重级别配色（浅色/深色各一套）：时间线条目、功能开关的前置条件提示等共用。
                 取色与 NoticeBar 的 WinUI InfoBar 配色一致：信息=蓝、成功=绿、警告=橙、错误=红。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeverityMutedFillBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="SeverityMutedStrokeBrush" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="SeverityMutedAccentBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="SeverityInfoFillBrush" Color="#F3F9FD" />
                    <SolidColorBrush x:Key="SeverityInfoStrokeBrush" Color="#B3D6F2" />
                    <SolidColorBrush x:Key="SeverityInfoAccentBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="SeveritySuccessFillBrush" Color="#F1FAF1" />
                    <SolidColorBrush x:Key="SeveritySuccessStrokeBrush" Color="#BAD80A" />
                    <SolidColorBrush x:Key="SeveritySuccessAccentBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="SeverityWarningFillBrush" Color="#FFF9F0" />
                    <SolidColorBrush x:Key="SeverityWarningStrokeBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="SeverityWarningAccentBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="SeverityErrorFillBrush" Color="#FDF3F4" />
                    <SolidColorBrush x:Key="SeverityErrorStrokeBrush" Color="#F1707B" />
                    <SolidColorBrush x:Key="SeverityErrorAccentBrush" Color="#B10E1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeverityMutedFillBrush" Color="#232323" />
                    <SolidColorBrush x:Key="SeverityMutedStrokeBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="SeverityMutedAccentBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="SeverityInfoFillBrush" Color="#1B2A3A" />
                    <SolidColorBrush x:Key="SeverityInfoStrokeBrush" Color="#2F4A63" />
                    <SolidColorBrush x:Key="SeverityInfoAccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="SeveritySuccessFillBrush" Color="#1E3A1E" />
                    <SolidColorBrush x:Key="SeveritySuccessStrokeBrush" Color="#3E6B3E" />
                    <SolidColorBrush x:Key="SeveritySuccessAccentBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SeverityWarningFillBrush" Color="#433519" />
                    <SolidColorBrush x:Key="SeverityWarningStrokeBrush" Color="#6B5A2A" />
                    <SolidColorBrush x:Key="SeverityWarningAccentBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="SeverityErrorFillBrush" Color="#442726" />
                    <SolidColorBrush x:Key="SeverityErrorStrokeBrush" Color="#6E3A3A" />
                    <SolidColorBrush x:Key="SeverityErrorAccentBrush" Color="#FF99A4" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

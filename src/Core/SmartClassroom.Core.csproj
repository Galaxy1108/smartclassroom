<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\SmartClassroom.Contracts.csproj" />
    <!-- IPC 客户端：2.1.0 是最后一个含 net8.0 构建的版本（2.1.1.x 仅 net10.0）；
         与 2.1.x 主机同 dotnetCampus.Ipc alpha410，协议一致，联调复核。 -->
    <PackageReference Include="ClassIsland.Shared.Ipc" Version="2.1.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- 让 Core 的测试能验证 internal 辅助方法（例如 WS 地址拼装） -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SmartClassroom.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
